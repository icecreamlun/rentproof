# ─── Google Gemini (核心:合同解析 + 照片视觉对比) ────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash

# ─── Exa (法条 / 判例检索) ────────────────────────────────────────────
# https://dashboard.exa.ai  code: EXA50BUILDCLUB
EXA_API_KEY=

# ─── Apify (抓取州法规原文 + 房东历史投诉) ────────────────────────────
# https://console.apify.com/account/integrations
APIFY_TOKEN=
APIFY_CRAWLER_ACTOR=apify~website-content-crawler
APIFY_SEARCH_ACTOR=apify~google-search-scraper

# ─── Vapi (AI 代打电话给房东) ─────────────────────────────────────────
# https://dashboard.vapi.ai  code: HackBC081726
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# 可选:在 Vapi dashboard 建好 assistant 后填这里,会用 assistantOverrides 传变量
VAPI_ASSISTANT_ID=
VAPI_MODEL_PROVIDER=google
VAPI_MODEL=gemini-2.0-flash

# ─── ElevenLabs (多语言语音简报 / 电话音色) ───────────────────────────
# Discord #coupon-codes 领 110k credits
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# ─── Resend (发送 demand letter 邮件,可选) ───────────────────────────
RESEND_API_KEY=
RESEND_FROM="RentProof <onboarding@resend.dev>"

# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=RentProof

# ─── Convex (实时 case 状态 + 通话事件流 + 定时自动跟进) ──────────────
# npx convex dev 会自动填这两个
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=
